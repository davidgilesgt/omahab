{
  "id": "hermes",
  "name": "Hermes",
  "port": 8085,
  "default_exposure": "private",
  "max_exposure": "shared",
  "health_check": {
    "kind": "http",
    "path": "/api/status",
    "port": 8085
  },
  "startup_grace_seconds": 300,
  "oidc": {
    "supported": true,
    "mode": "native",
    "provider": "pocket-id"
  },
  "resources": {
    "memory_mb": 2048
  },
  "default": true,
  "route": "ai.{{.Domain}}",
  "app_path": "/",
  "dependencies": [
    "litellm",
    "pocket-id",
    "hindsight"
  ],
  "units": [
    "docker-hermes.service"
  ],
  "groups": [
    "members",
    "admins"
  ]
}

{
  "id": "forgejo",
  "name": "Forgejo",
  "port": 3000,
  "default_exposure": "private",
  "max_exposure": "public",
  "health_check": {
    "kind": "http",
    "path": "/api/healthz",
    "port": 3000
  },
  "startup_grace_seconds": 180,
  "oidc": {
    "supported": true,
    "mode": "native",
    "provider": "pocket-id"
  },
  "resources": {
    "memory_mb": 1024
  },
  "default": true,
  "route": "git",
  "app_path": "/",
  "dependencies": [
    "caddy",
    "pocket-id"
  ],
  "secret_sources": [
    "forgejo_db_password",
    "forgejo_secret_key"
  ],
  "units": [
    "forgejo.service"
  ],
  "groups": [
    "members",
    "admins"
  ]
}

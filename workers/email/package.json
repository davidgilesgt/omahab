{
  "name": "@omahab/email-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Omahab Cloudflare Email Worker — minimal transport adapter with HMAC auth",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "generate:vars": "node scripts/generate-vars.mjs --domain",
    "generate:alias": "node scripts/generate-vars.mjs --alias",
    "knip": "knip"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250820.0",
    "knip": "5.88.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.30.0"
  }
}

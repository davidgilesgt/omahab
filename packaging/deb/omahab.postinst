#!/bin/sh
# omahab postinst — the appliance installer deliberately starts omahabd only
# after host configuration; a package install or upgrade never starts it on a
# fresh system. Upgrades restart the daemon only when its unit is enabled.
set -e

if [ "$1" != configure ]; then
    exit 0
fi

# Create /etc/omahab, /var/lib/omahab (0700), /var/lib/omahab/secrets (0700)
# and /srv/omahab according to the shipped tmpfiles.d fragment so omahabd
# can start on a fresh system.
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create >/dev/null || true
fi

# Best-effort: install shell completions so `omahab` is on PATH and
# tab-complete works immediately after dpkg -i (the installer also does this
# via the binaries step, but deb upgrades bypass that path).
if command -v omahab >/dev/null 2>&1; then
    mkdir -p /usr/share/bash-completion/completions /usr/share/zsh/site-functions /usr/share/fish/vendor_completions.d >/dev/null 2>&1 || true
    omahab completion bash > /usr/share/bash-completion/completions/omahab 2>/dev/null || true
    omahab completion zsh > /usr/share/zsh/site-functions/_omahab 2>/dev/null || true
    omahab completion fish > /usr/share/fish/vendor_completions.d/omahab.fish 2>/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper unmask omahabd.service >/dev/null || true
    # preset, not enable: honor the sysadmin's and installer's policy.
    deb-systemd-helper preset omahabd.service >/dev/null || true
fi

# Upgrading an already-enabled unit: restart to pick up the new binaries.
# omahab-clientd is a user unit; package maintainer scripts never touch it.
if [ -n "${2:-}" ] &&
   command -v deb-systemd-invoke >/dev/null 2>&1 &&
   command -v deb-systemd-helper >/dev/null 2>&1 &&
   deb-systemd-helper --quiet was-enabled omahabd.service; then
    deb-systemd-invoke try-restart omahabd.service >/dev/null || true
fi

exit 0

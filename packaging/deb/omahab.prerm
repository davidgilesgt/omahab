#!/bin/sh
# omahab prerm — stop the control plane when the package is removed.
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop omahabd.service >/dev/null || true
    else
        systemctl --system stop omahabd.service >/dev/null || true
    fi
fi

exit 0

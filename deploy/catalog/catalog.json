{
  "bundles": [
    {
      "id": "caddy",
      "name": "Caddy",
      "port": 80,
      "default_exposure": "public",
      "max_exposure": "public",
      "health_check": {
        "kind": "http",
        "path": "/config/",
        "port": 2019
      },
      "data": [
        {
          "name": "caddy_data",
          "path": "/data"
        },
        {
          "name": "caddy_config",
          "path": "/config"
        }
      ],
      "backup": {
        "post_restore": [
          "/bin/sh",
          "-c",
          "systemctl reload caddy || true"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "",
      "units": [
        "caddy.service"
      ],
      "groups": [
        "admins"
      ]
    },
    {
      "id": "pocket-id",
      "name": "Pocket ID",
      "port": 1411,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/health",
        "port": 1411
      },
      "data": [
        {
          "name": "pocket_id_data",
          "path": "/app/backend/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "sqlite3 /app/backend/data/data.db \".backup '/var/lib/omahab/dumps/pocket-id.db'\" || cp /app/backend/data/data.db /var/lib/omahab/dumps/pocket-id.db"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "cp /var/lib/omahab/dumps/pocket-id.db /app/backend/data/data.db && systemctl restart pocket-id.service"
        ]
      },
      "oidc": {
        "supported": true,
        "mode": "provider"
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "id",
      "dependencies": [
        "caddy"
      ],
      "secret_sources": [
        "pocket_id_encryption_key",
        "maxmind_license"
      ],
      "units": [
        "pocket-id.service"
      ],
      "groups": [
        "admins"
      ]
    },
    {
      "id": "forgejo",
      "name": "Forgejo",
      "port": 3000,
      "default_exposure": "private",
      "max_exposure": "public",
      "health_check": {
        "kind": "http",
        "path": "/-/healthz",
        "port": 3000
      },
      "data": [
        {
          "name": "forgejo_data",
          "path": "/data"
        },
        {
          "name": "forgejo_postgres_data",
          "path": "/var/lib/postgresql/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d forgejo -f /var/lib/omahab/dumps/forgejo.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d forgejo /var/lib/omahab/dumps/forgejo.pgdump && systemctl restart forgejo.service"
        ]
      },
      "oidc": {
        "supported": true,
        "mode": "native",
        "provider": "pocket-id"
      },
      "resources": {
        "memory_mb": 1024
      },
      "default": true,
      "route": "git",
      "dependencies": [
        "caddy",
        "pocket-id"
      ],
      "secret_sources": [
        "forgejo_db_password",
        "forgejo_secret_key"
      ],
      "units": [
        "forgejo.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "woodpecker",
      "name": "Woodpecker CI",
      "port": 8000,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/healthz",
        "port": 8000
      },
      "data": [
        {
          "name": "woodpecker_data",
          "path": "/var/lib/woodpecker"
        },
        {
          "name": "woodpecker_postgres_data",
          "path": "/var/lib/postgresql/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d woodpecker -f /var/lib/omahab/dumps/woodpecker.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d woodpecker /var/lib/omahab/dumps/woodpecker.pgdump && systemctl restart woodpecker-server.service woodpecker-agent-docker.service"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 512
      },
      "default": true,
      "route": "ci",
      "dependencies": [
        "caddy",
        "forgejo"
      ],
      "secret_sources": [
        "woodpecker_forgejo_client_id",
        "woodpecker_forgejo_client_secret",
        "woodpecker_agent_secret",
        "woodpecker_grpc_secret",
        "woodpecker_db_url",
        "woodpecker_db_password"
      ],
      "pipeline_image": "quay.io/podman/stable@sha256:943585c013eeeb5acc9f4e6d2a81d80c6b0be3069557cbb9a5aa737a8c4aae3e",
      "units": [
        "woodpecker-server.service",
        "woodpecker-agent-docker.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "immich",
      "name": "Immich",
      "port": 2283,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/api/server/ping",
        "port": 2283
      },
      "data": [
        {
          "name": "immich_postgres_data",
          "path": "/var/lib/postgresql/data"
        },
        {
          "name": "immich_redis_data",
          "path": "/data"
        },
        {
          "name": "immich_model_cache",
          "path": "/cache"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d immich -f /var/lib/omahab/dumps/immich.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d immich /var/lib/omahab/dumps/immich.pgdump && systemctl restart immich-server.service immich-machine-learning.service"
        ]
      },
      "oidc": {
        "supported": true,
        "mode": "native",
        "provider": "pocket-id"
      },
      "resources": {
        "memory_mb": 4096
      },
      "default": true,
      "route": "photos",
      "dependencies": [
        "caddy",
        "pocket-id"
      ],
      "secret_sources": [
        "immich_db_password"
      ],
      "units": [
        "immich-server.service",
        "immich-machine-learning.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "paperless-ngx",
      "name": "Paperless-ngx",
      "port": 8000,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/api/",
        "port": 8000
      },
      "data": [
        {
          "name": "paperless_postgres_data",
          "path": "/var/lib/postgresql/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d paperless -f /var/lib/omahab/dumps/paperless-ngx.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d paperless /var/lib/omahab/dumps/paperless-ngx.pgdump && systemctl restart paperless-web.service paperless-consumer.service paperless-scheduler.service"
        ]
      },
      "oidc": {
        "supported": true,
        "mode": "native",
        "provider": "pocket-id"
      },
      "resources": {
        "memory_mb": 2048
      },
      "default": true,
      "route": "docs",
      "dependencies": [
        "caddy",
        "pocket-id"
      ],
      "secret_sources": [
        "paperless_db_password",
        "paperless_secret_key"
      ],
      "units": [
        "paperless-web.service",
        "paperless-consumer.service",
        "paperless-scheduler.service",
        "paperless-tika.service",
        "paperless-gotenberg.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "karakeep",
      "name": "Karakeep",
      "port": 3000,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/api/health",
        "port": 3000
      },
      "data": [
        {
          "name": "karakeep_data",
          "path": "/data"
        },
        {
          "name": "karakeep_postgres_data",
          "path": "/var/lib/postgresql/data"
        },
        {
          "name": "karakeep_meili_data",
          "path": "/meili_data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d karakeep -f /var/lib/omahab/dumps/karakeep.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d karakeep /var/lib/omahab/dumps/karakeep.pgdump && systemctl restart karakeep.service"
        ]
      },
      "oidc": {
        "supported": true,
        "mode": "native",
        "provider": "pocket-id"
      },
      "resources": {
        "memory_mb": 1024
      },
      "default": true,
      "route": "save",
      "dependencies": [
        "caddy",
        "pocket-id"
      ],
      "secret_sources": [
        "karakeep_db_password",
        "karakeep_nextauth_secret",
        "karakeep_meili_master_key"
      ],
      "units": [
        "karakeep.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "syncthing",
      "name": "Syncthing",
      "port": 8384,
      "default_exposure": "private",
      "max_exposure": "private",
      "health_check": {
        "kind": "http",
        "path": "/rest/system/ping",
        "port": 8384
      },
      "data": [
        {
          "name": "syncthing_config",
          "path": "/var/syncthing/config"
        }
      ],
      "backup": {
        "post_restore": [
          "/bin/sh",
          "-c",
          "systemctl restart syncthing.service"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 512
      },
      "default": true,
      "route": "sync",
      "dependencies": [
        "caddy"
      ],
      "secret_sources": [
        "syncthing_api_key",
        "syncthing_gui_password"
      ],
      "units": [
        "syncthing.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "litellm",
      "name": "LiteLLM Model Gateway",
      "port": 4000,
      "default_exposure": "private",
      "max_exposure": "private",
      "health_check": {
        "kind": "http",
        "path": "/health/liveliness",
        "port": 4000
      },
      "data": [
        {
          "name": "litellm_postgres_data",
          "path": "/var/lib/postgresql/data"
        },
        {
          "name": "litellm_auth",
          "path": "/var/lib/litellm-auth"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "pg_dump -Fc -d litellm -f /var/lib/omahab/dumps/litellm.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "pg_restore --clean --if-exists -d litellm /var/lib/omahab/dumps/litellm.pgdump && systemctl restart litellm.service"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 512
      },
      "default": true,
      "route": "models",
      "dependencies": [
        "caddy"
      ],
      "secret_sources": [
        "litellm_master_key",
        "litellm_db_url",
        "litellm_db_password",
        "litellm_salt_key"
      ],
      "units": [
        "litellm.service"
      ],
      "groups": [
        "admins"
      ]
    },
    {
      "id": "embedding-worker",
      "name": "Embedding Worker",
      "port": 8090,
      "default_exposure": "private",
      "max_exposure": "private",
      "health_check": {
        "kind": "none"
      },
      "data": [
        {
          "name": "embedding_models",
          "path": "/models"
        }
      ],
      "backup": {
        "post_restore": [
          "/bin/sh",
          "-c",
          "systemctl restart omahab-embedding-worker.service"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 1536
      },
      "default": true,
      "route": "",
      "units": [
        "omahab-embedding-worker.service"
      ],
      "groups": [
        "admins"
      ]
    },
    {
      "id": "ntfy",
      "name": "ntfy",
      "port": 2586,
      "default_exposure": "private",
      "max_exposure": "public",
      "health_check": {
        "kind": "http",
        "path": "/v1/health",
        "port": 2586
      },
      "data": [
        {
          "name": "ntfy_cache",
          "path": "/var/cache/ntfy"
        },
        {
          "name": "ntfy_config",
          "path": "/etc/ntfy"
        }
      ],
      "backup": {
        "post_restore": [
          "/bin/sh",
          "-c",
          "systemctl restart ntfy-sh.service"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "ntfy",
      "dependencies": [
        "caddy"
      ],
      "secret_sources": [
        "ntfy_auth_file"
      ],
      "units": [
        "ntfy-sh.service"
      ],
      "groups": [
        "admins"
      ]
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "port": 9119,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "http",
        "path": "/api/status",
        "port": 9119
      },
      "data": [
        {
          "name": "hermes_home",
          "path": "/var/lib/omahab/hermes"
        }
      ],
      "oidc": {
        "supported": true,
        "mode": "native",
        "provider": "pocket-id"
      },
      "resources": {
        "memory_mb": 2048
      },
      "default": true,
      "route": "ai.{{.Domain}}",
      "dependencies": [
        "litellm",
        "pocket-id"
      ],
      "units": [
        "docker-hermes.service"
      ],
      "groups": [
        "members",
        "admins"
      ]
    },
    {
      "id": "restic-server",
      "name": "Restic REST Server",
      "port": 8500,
      "default_exposure": "private",
      "max_exposure": "private",
      "health_check": {
        "kind": "http",
        "path": "/",
        "port": 8500
      },
      "data": [
        {
          "name": "machine_backups",
          "path": "/srv/omahab/machine-backups"
        }
      ],
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "backup.{{.Domain}}",
      "dependencies": [
        "caddy"
      ],
      "units": [
        "restic-rest-server.service"
      ],
      "groups": [
        "admins"
      ]
    }
  ]
}

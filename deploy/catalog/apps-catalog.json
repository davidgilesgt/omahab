        "pre_backup": [
          "/bin/sh",
          "-c",
          "docker compose -f /srv/omahab/apps/syncthing/compose.yaml exec syncthing syncthing cli --gui-apikey $(cat /run/secrets/syncthing_api_key) operations pause || true \u0026\u0026 sleep 2"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "rsync -a /backups/syncthing/sync/ /srv/omahab/sync/ \u0026\u0026 docker compose -f /srv/omahab/apps/syncthing/compose.yaml restart syncthing"
        ]

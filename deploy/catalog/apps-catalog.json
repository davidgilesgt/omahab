        "command": [
          "sh",
          "-c",
          "curl -fk https://127.0.0.1:8384/rest/system/ping -H \"X-API-Key: $(cat /run/secrets/syncthing_api_key 2\u003e/dev/null || echo dummy)\" || wget --no-verbose --tries=1 --spider http://127.0.0.1:8384/rest/system/ping || exit 1"
        ]
      },
      "data": [
        {
          "name": "syncthing_config",
          "path": "/var/syncthing/config"
        }

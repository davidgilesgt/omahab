          "path": "/var/lib/postgresql/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "runuser -u postgres -- pg_dump -Fc -d forgejo -f /var/lib/omahab/dumps/forgejo.pgdump"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "runuser -u postgres -- pg_restore --clean --if-exists -d forgejo /var/lib/omahab/dumps/forgejo.pgdump \u0026\u0026 systemctl restart forgejo.service"

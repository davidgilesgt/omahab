{
  "bundles": [
    {
      "id": "caddy",
      "name": "Caddy",
      "image": "",
      "digest": "",
      "architectures": [
        "amd64",
        "arm64"
      ],
      "compose": "",
      "default_exposure": "public",
      "max_exposure": "public",
      "health_check": {
        "kind": "command",
        "service": "caddy",
        "command": [
          "sh",
          "-c",
          "caddy version \u003e/dev/null 2\u003e\u00261 \u0026\u0026 wget --no-verbose --tries=1 --spider http://127.0.0.1:2019/config/ || exit 1"
        ]
      },
      "data": [
        {
          "name": "caddy_data",
          "path": "/data"
        },
        {
          "name": "caddy_config",
          "path": "/config"
        }
      ],
      "backup": {
        "post_restore": [
          "/bin/sh",
          "-c",
          "systemctl reload caddy || docker compose -f /srv/omahab/apps/caddy/compose.yaml exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile || true"
        ]
      },
      "oidc": {
        "supported": false
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "",
      "runtime": "systemd",
      "units": [
        "caddy.service"
      ]
    },
    {
      "id": "pocket-id",
      "name": "Pocket ID",
      "image": "",
      "digest": "",
      "architectures": [
        "amd64",
        "arm64"
      ],
      "compose": "",
      "port": 1411,
      "default_exposure": "private",
      "max_exposure": "shared",
      "health_check": {
        "kind": "command",
        "service": "pocket-id",
        "command": [
          "sh",
          "-c",
          "wget --no-verbose --tries=1 --spider http://127.0.0.1:1411/health || exit 1"
        ]
      },
      "data": [
        {
          "name": "pocket_id_data",
          "path": "/app/backend/data"
        }
      ],
      "backup": {
        "pre_backup": [
          "/bin/sh",
          "-c",
          "docker compose -f /srv/omahab/apps/pocket-id/compose.yaml exec pocket-id /app/backend/pocket-id backup --out /tmp/pocket-id-backup.db || cp /app/backend/data/data.db /tmp/pocket-id-backup.db"
        ],
        "post_restore": [
          "/bin/sh",
          "-c",
          "docker compose -f /srv/omahab/apps/pocket-id/compose.yaml exec pocket-id /app/backend/pocket-id restore --in /tmp/pocket-id-backup.db || cp /tmp/pocket-id-backup.db /app/backend/data/data.db"
        ]
      },
      "oidc": {
        "supported": true
      },
      "resources": {
        "memory_mb": 256
      },
      "default": true,
      "route": "id",
      "dependencies": [
        "caddy"
      ],
      "secret_sources": [
        "pocket_id_encryption_key",
        "maxmind_license"
      ],
      "runtime": "systemd",
      "units": [
        "pocket-id.service"
      ]
    },
    {

[Unit]
Description=Omahab Control Plane (omahabd)
Documentation=https://github.com/davidgilesgt/omahab
After=network-online.target docker.service tailscaled.service
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/srv/omahab
ConditionPathExists=/etc/omahab
StartLimitIntervalSec=60
StartLimitBurst=5
[Service]
Type=simple # binary does not sd_notify
ExecStart=/usr/bin/omahabd --config /etc/omahab/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# --- Identity / paths ---
User=root
Group=root
SupplementaryGroups=docker
WorkingDirectory=/var/lib/omahab
StateDirectory=omahab
StateDirectoryMode=0700
CacheDirectory=omahab
LogsDirectory=omahab
ConfigurationDirectory=omahab
ConfigurationDirectoryMode=0755
# omahabd owns /srv/omahab/apps, /srv/omahab/projects, etc via /srv/omahab
ReadWritePaths=/var/lib/omahab /etc/omahab /srv/omahab
ReadOnlyPaths=/usr/bin/omahabd
Environment=OMAHAB_ETC_DIR=/etc/omahab
Environment=OMAHAB_STATE_DIR=/var/lib/omahab
Environment=OMAHAB_DATA_DIR=/srv/omahab
# Never leak secrets via Environment; secrets go via /var/lib/omahab/secrets + tmpfs /run/secrets
EnvironmentFile=-/etc/omahab/omahabd.env

# --- Sandboxing (hardened but compatible with Docker socket control) ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
# omahabd needs to dial Docker; allow /run/docker.sock via SupplementaryGroups, but do not mount it into apps
PrivateMounts=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=no
ProtectClock=no
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=no
RemoveIPC=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# omahabd manages ownership of state, secrets, and application directories;
# @chown is inside @privileged and must be re-allowed after the deny line.
SystemCallFilter=@chown
SecureBits=keep-caps

# --- Resource & security ---
LimitNOFILE=65536
LimitNPROC=4096
TimeoutStopSec=30
KillMode=mixed

# --- Logging (structured, never log secret values — audit logs contain IDs only) ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omahabd

[Install]
WantedBy=multi-user.target

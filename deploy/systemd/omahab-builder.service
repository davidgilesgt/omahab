[Unit]
Description=Omahab builder Podman API service (socket-activated)
Documentation=https://github.com/davidgilesgt/omahab
Requires=omahab-builder.socket
After=omahab-builder.socket
RequiresMountsFor=/var/lib/omahab-builder
ConditionPathExists=/var/lib/omahab-builder
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=omahab-builder
Group=omahab-builder
Environment=HOME=/var/lib/omahab-builder
ExecStart=/usr/bin/podman system service --time=0
Restart=on-failure
RestartSec=3

SupplementaryGroups=
WorkingDirectory=/var/lib/omahab-builder
StateDirectory=omahab-builder
StateDirectoryMode=0700
ReadWritePaths=/var/lib/omahab-builder /run/omahab-builder
ReadOnlyPaths=/usr/bin/podman
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=strict
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=no
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=no
RemoveIPC=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=65536
TimeoutStopSec=30
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omahab-builder

[Install]
WantedBy=multi-user.target

#!/bin/sh
# Omahab bootstrap installer (DESIGN.md 5.3).
#
# Reviewed-then-run convenience bootstrap:
#
#   curl -fL -o omahab-install https://raw.githubusercontent.com/davidgilesgt/omahab/master/scripts/install
#   less omahab-install
#   sudo sh omahab-install
#
# Nothing is ever piped from the network into a shell. The bootstrap has
# exactly four responsibilities:
#
#   1. identify OS version (Debian 13 or Ubuntu 26.04) and CPU architecture;
#   2. download the versioned installer plus its signed release metadata;
#   3. verify the signed metadata (minisign) and the installer checksum;
#   4. exec the verified installer.
#
# It installs nothing and writes no persistent state; every host change
# belongs to the signed installer. It fails closed when a required tool is
# missing, a download cannot be authenticated over HTTPS, or any check does
# not pass.
#
# Host requirements: POSIX sh plus id, uname, sed, tr, grep, chmod, mktemp,
# rm, sha256sum, minisign, and curl (or wget). On Debian 13 / Ubuntu 26.04:

  apt-get install minisign curl
#
# Environment overrides (signature verification stays mandatory regardless;
# the minisign trust anchor below is not overridable):
#
#   OMAHAB_RELEASE_URL  release channel base URL; must be https://
#                       (default: https://github.com/davidgilesgt/omahab/releases/latest/download,
#                       the latest non-draft GitHub release of the repository)
#   OMAHAB_CACERT       CA bundle for a private mirror's TLS certificate;
#                       must be an absolute path to a readable file
#
# Release layout consumed (produced by scripts/release.sh):
#
#   $RELEASE_BASE/SHA256SUMS       checksums of all release artifacts,
#                                  including the versioned installer
#   $RELEASE_BASE/SHA256SUMS.sig   detached minisign signature of SHA256SUMS
#   $RELEASE_BASE/omahab-installer-<version>-<arch>
#
# Any remaining arguments are forwarded to the installer, for example
# `sudo sh omahab-install --non-interactive`.

set -eu
umask 077
LC_ALL=C
export LC_ALL=C

RELEASE_BASE="${OMAHAB_RELEASE_URL:-https://github.com/davidgilesgt/omahab/releases/latest/download}"

# Release signing public key (minisign, the base64 line only). This is the
# trust anchor of the whole installation; it is also published as
# release/minisign.pub in the repository and must match. The matching
# private key is kept offline by the release process. Rotating the key means
# replacing this constant and republishing the bootstrap.
OMAHAB_PUBKEY='RWRJFypCZzAmvE+IVI/STZ4Dn98NkoYQrHSH8RG/5uLubfNTv02C+xt5'

die() {
    echo "omahab-install: error: $*" >&2
    exit 1
}

# --- tooling (fail closed on anything missing or unusable) -----------------

for tool in id uname sed tr grep chmod mktemp rm sha256sum minisign; do
    command -v "$tool" >/dev/null 2>&1 ||
        die "required tool '$tool' not found; on Debian 13 / Ubuntu 26.04 run: apt-get install $tool (on Arch/Omarchy: pacman -S $tool)"
done

cacert=''
if [ -n "${OMAHAB_CACERT:-}" ]; then
    case $OMAHAB_CACERT in
        /*) ;;
        *) die "OMAHAB_CACERT must be an absolute path" ;;
    esac
    [ -f "$OMAHAB_CACERT" ] || die "OMAHAB_CACERT is not a readable file: $OMAHAB_CACERT"
    cacert=$OMAHAB_CACERT
fi

fetch() {
    # fetch <url> <destination-file>; HTTPS only, hard failure on any error.
    if command -v curl >/dev/null 2>&1; then
        if [ -n "$cacert" ]; then
            curl --fail --silent --show-error --location \
                --proto '=https' --tlsv1.2 --retry 2 --retry-delay 1 \
                --max-time 180 --cacert "$cacert" \
                --output "$2" "$1" || die "download failed: $1"
        else
            curl --fail --silent --show-error --location \
                --proto '=https' --tlsv1.2 --retry 2 --retry-delay 1 \
                --max-time 180 \
                --output "$2" "$1" || die "download failed: $1"
        fi
    elif command -v wget >/dev/null 2>&1; then
        case $1 in
            https://*) ;;
            *) die "download URL must be https:// (got: $1)" ;;
        esac
        if [ -n "$cacert" ]; then
            wget --no-verbose --output-document="$2" \
                --ca-certificate="$cacert" "$1" || die "download failed: $1"
        else
            wget --no-verbose --output-document="$2" "$1" || die "download failed: $1"
        fi
    else
        die "required tool 'curl' (or 'wget') not found; on Debian 13 / Ubuntu 26.04 run: apt-get install curl (on Arch/Omarchy: pacman -S curl)"
    fi
}

# --- 1. identify OS version and CPU architecture -----------------------

[ "$(id -u)" -eq 0 ] || die "must run as root (try: sudo sh omahab-install)"

case $RELEASE_BASE in
    https://*) ;;
    *) die "OMAHAB_RELEASE_URL must be an https:// URL (default https://github.com/davidgilesgt/omahab/releases/latest/download, got: $RELEASE_BASE)" ;;
esac

[ -r /etc/os-release ] || die "cannot read /etc/os-release; unsupported system (Debian 13 or Ubuntu 26.04 is required)"

# Parsed, never sourced: os-release must not be executed as shell.
os_id=$(sed -n 's/^ID=//p' /etc/os-release | tail -n 1 | tr -d '"' | tr -d "'")
os_version=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tail -n 1 | tr -d '"' | tr -d "'")

case $os_id in
    debian)
        case $os_version in
            13) ;;
            *) die "unsupported Debian version ${os_version:-unknown}; Debian 13 (trixie) is required" ;;
        esac
        ;;
    ubuntu)
        case $os_version in
            26.04) ;;
            *) die "unsupported Ubuntu version ${os_version:-unknown}; Ubuntu 26.04 (resolute) is required" ;;
        esac
        ;;
    *) die "unsupported operating system (ID=${os_id:-unknown}); this bootstrap supports Debian 13 and Ubuntu 26.04 only" ;;
esac

case $(uname -m) in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) die "unsupported CPU architecture $(uname -m); supported: x86_64 (amd64), aarch64 (arm64)" ;;
esac

# --- 2. download the signed release metadata into a private temp dir -------

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/omahab-install.XXXXXXXX") ||
    die "mktemp failed"

cleanup() {
    rm -rf -- "$tmpdir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

sums="$tmpdir/SHA256SUMS"
sig="$tmpdir/SHA256SUMS.sig"

fetch "$RELEASE_BASE/SHA256SUMS" "$sums"
fetch "$RELEASE_BASE/SHA256SUMS.sig" "$sig"

# --- 3. verify the signature, select the installer, verify its checksum ----

# -Vm verifies both the signature and the trusted comment against the
# embedded key; any tampering, wrong key, or wrong tool fails here.
minisign -Vm "$sums" -x "$sig" -P "$OMAHAB_PUBKEY" >/dev/null ||
    die "minisign verification of SHA256SUMS failed; release metadata is not trusted, refusing to continue"

# The installer entry is taken from the verified manifest only: exactly one
# line, flat filename without slashes, version starting with a digit.
pattern="^[0-9a-f]{64}[[:space:]]+omahab-installer-[0-9][0-9A-Za-z.+-]*-${arch}$"
count=$(grep -Ec "$pattern" "$sums" || true)
case $count in
    1) ;;
    0) die "no installer artifact for linux/$arch in the signed SHA256SUMS (expected omahab-installer-<version>-$arch)" ;;
    *) die "ambiguous installer entries for linux/$arch in the signed SHA256SUMS ($count matches)" ;;
esac

line=$(grep -E "$pattern" "$sums")

read -r want_sha256 installer_name <<MANIFEST_LINE
$line
MANIFEST_LINE
[ -n "$want_sha256" ] && [ -n "$installer_name" ] ||
    die "malformed installer entry in SHA256SUMS"
version=$(printf '%s' "$installer_name" | sed "s/^omahab-installer-//; s/-${arch}\$//")
echo "omahab-install: $os_id $os_version linux/$arch, installer $version" >&2

installer="$tmpdir/$installer_name"
fetch "$RELEASE_BASE/$installer_name" "$installer"

have_sha256=$(sha256sum "$installer" | sed 's/[[:space:]].*//')
[ "$have_sha256" = "$want_sha256" ] ||
    die "checksum mismatch for $installer_name; refusing to continue"

# --- 4. exec the verified installer and handle PATH --------------------------

chmod 0700 "$installer"

# The manifest and signature are no longer needed. The verified installer
# itself cannot be unlinked before it runs: exec hands this terminal and
# this process to it, and the remaining root-owned 0700 file inside the
# 0700 temporary directory is later removed by the system's age-based tmpfiles
# cleanup of TMPDIR.
rm -f -- "$sums" "$sig"

# Run the installer without exec so we can report PATH status afterwards.
# The installer already prints completion/PATH guidance, but the bootstrap
# also clears the shell hash and verifies `omahab` is on PATH for both root
# and the invoking user (SUDO_USER) so a stale hash does not hide the new
# binary.
set +e
"$installer" "$@"
rc=$?
set -e
if [ $rc -eq 0 ]; then
    hash -r 2>/dev/null || true
    if ! command -v omahab >/dev/null 2>&1; then
        echo "omahab-install: warning: 'omahab' not found in PATH ($PATH) — binary is at /usr/bin/omahab; open a new shell or run: hash -r" >&2
    fi
    # Also check the invoking user's PATH when run via sudo.
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        if command -v sudo >/dev/null 2>&1; then
            if ! sudo -u "$SUDO_USER" sh -c 'command -v omahab >/dev/null 2>&1'; then
                user_path=$(sudo -u "$SUDO_USER" sh -c 'echo $PATH' 2>/dev/null || echo "?")
                echo "omahab-install: note: 'omahab' not in $SUDO_USER's PATH ($user_path) — ensure /usr/bin is in PATH or open a new shell" >&2
            fi
        fi
    fi
fi
exit $rc

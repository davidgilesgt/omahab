#!/bin/sh
# Omahab setup script: builds from source and starts the installer.
#
# Run it as a regular user with sudo permission, right after cloning the
# repository into a nonroot location:
#
#   git clone --depth 1 https://github.com/davidgilesgt/omahab ~/omahab
#   sh ~/omahab/scripts/setup
#
# The script bundles every step that follows the clone:
#
#  1. install the build prerequisites with sudo (ca-certificates, golang-go, nodejs, npm, skopeo);
#   2. compile the Omahab binaries into ~/omahab/dist (no root needed);
#   3. exec the installer with sudo.
#
# It must not run as root: the clone and the build stay owned by the user.
# Host requirements: Debian 13 or Ubuntu 26.04 (apt-get) with sudo.
#
# Any remaining arguments are forwarded to the installer, for example
# `sh scripts/setup preflight` or `sh scripts/setup --non-interactive`.

set -eu
umask 022

die() {
    echo "omahab-setup: error: $*" >&2
    exit 1
}

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ "$(id -u)" -eq 0 ]; then
    die "do not run as root; run as a regular user with sudo permission so the repository and the build stay in a nonroot home"
fi
command -v sudo >/dev/null 2>&1 ||
    die "required tool 'sudo' not found; run as a regular user with sudo permission"
command -v apt-get >/dev/null 2>&1 ||
    die "required tool 'apt-get' not found; this setup script supports Debian 13 and Ubuntu 26.04"

echo "omahab-setup: installing build prerequisites"
sudo apt-get update
sudo apt-get install -y ca-certificates golang-go nodejs npm skopeo

echo "omahab-setup: building Omahab in $ROOT (this takes several minutes)"
cd "$ROOT"
GOTOOLCHAIN=auto bash scripts/build.sh --version 0.0.0-dev

case $(uname -m) in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) die "unsupported CPU architecture $(uname -m); supported: x86_64 (amd64), aarch64 (arm64)" ;;
esac

installer="$ROOT/dist/$arch/omahab-install"
[ -x "$installer" ] || die "the build did not produce $installer"

echo "omahab-setup: starting the installer (linux/$arch)"
set +e
sudo "$installer" "$@"
rc=$?
set -e

# Post-install PATH handling: the installer places `omahab` in /usr/bin which
# is on PATH on Debian/Ubuntu, but the current shell may have a stale hash
# or a minimal PATH without /usr/bin. Report status so `omahab` is usable
# without opening a new shell.
if [ $rc -eq 0 ]; then
    # Clear the shell's command hash so a newly installed /usr/bin/omahab is
    # found without requiring a new login. `hash -r` is a no-op in shells
    # that do not support it.
    hash -r 2>/dev/null || true
    if command -v omahab >/dev/null 2>&1; then
        echo "omahab-setup: omahab is ready — $(command -v omahab) ($(omahab version 2>/dev/null || echo ok))"
        echo "omahab-setup: shell completions installed; open a new shell or run 'hash -r; exec \$SHELL -l' for tab-complete"
    else
        echo "omahab-setup: warning: 'omahab' not found in PATH ($PATH)" >&2
        echo "omahab-setup: the binary is at /usr/bin/omahab — add /usr/bin to PATH or open a new shell, then run: hash -r" >&2
        echo "omahab-setup: completions are at /usr/share/bash-completion/completions/omahab (bash), /usr/share/zsh/site-functions/_omahab (zsh), /usr/share/fish/vendor_completions.d/omahab.fish (fish)" >&2
    fi
fi
exit $rc
